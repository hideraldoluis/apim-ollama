{
	# Ajuste a CA/certificado em docs/rede-e-tls.md quando houver certificado corporativo.
	admin off

	# Quem abrir http://...:8443 é redirecionado para https na mesma porta
	# (sem isto, o Caddy responde "Client sent an HTTP request to an HTTPS server").
	servers :8443 {
		listener_wrappers {
			http_redirect
			tls
		}
	}
}

{$SITE_ADDRESS:localhost} {
	# CA interna do Caddy. Substituir por "tls /caminho/cert.pem /caminho/key.pem" se houver certificado corporativo.
	tls internal

	request_body {
		max_size 5MB
	}

	# Rotas públicas da API (compatível com OpenAI).
	@api path /v1/chat/completions /v1/completions /v1/embeddings /v1/models /v1/models/*
	handle @api {
		reverse_proxy litellm:4000 {
			# Streaming SSE sem buffer.
			flush_interval -1
		}
	}

	@health path /health/liveliness /health/readiness
	handle @health {
		reverse_proxy litellm:4000
	}

	# Tudo o mais (admin, UI, /key/*, /model/*, /metrics...) não é exposto na borda.
	handle {
		respond "Not found" 404
	}

	log {
		output stdout
		format console
	}
}

# Painel de governança: porta própria, só para a rede de gestão (PAINEL_CIDR, separados por espaço).
# Também restrinja a 8443 no firewall do host (docs/rede-e-tls.md).
{$SITE_ADDRESS:localhost}:8443 {
	tls internal

	request_body {
		max_size 1MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	@gestao remote_ip {$PAINEL_CIDR}
	handle @gestao {
		reverse_proxy painel:8080 {
			# Chat do painel: respostas em streaming (SSE) sem buffer.
			flush_interval -1
		}
	}

	handle {
		respond "Forbidden" 403
	}

	log {
		output stdout
		format console
	}
}
