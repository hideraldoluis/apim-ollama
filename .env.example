# Copie para .env e preencha. Nunca versione o .env.

# Chave de administração do gateway (formato sk-...). Gere com: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=

# Criptografa credenciais no banco. Gere uma vez e NÃO altere depois: echo "sk-$(openssl rand -hex 24)"
LITELLM_SALT_KEY=

# Senha do Postgres. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# Nome/host pelo qual os clientes acessam o gateway (ex.: gn100.empresa.local).
# "localhost" serve para testes locais.
SITE_ADDRESS=localhost

# Padrões das chaves novas (scripts/create-key.sh). Cada um pode ser sobrescrito por chave:
#   scripts/create-key.sh <alias> <modelos> <rpm> <paralelas> <validade>
# Modelos liberados, separados por vírgula (devem existir em config/litellm.yaml)
KEY_DEFAULT_MODELS=llama3.2
# Requisições por minuto
KEY_DEFAULT_RPM=30
# Requisições simultâneas
KEY_DEFAULT_PARALLEL=2
# Validade: 30d, 12h, 6mo... ou "never" (sem expiração)
KEY_DEFAULT_DURATION=90d

# Ollama (ajuste após medir na GN100)
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=10m
