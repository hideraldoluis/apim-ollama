# Copie para .env e preencha. Nunca versione o .env.

# Chave de administração do gateway (formato sk-...). Gere com: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=

# Criptografa credenciais no banco. Gere uma vez e NÃO altere depois: echo "sk-$(openssl rand -hex 24)"
LITELLM_SALT_KEY=

# Senha do Postgres. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# Nome/host pelo qual os clientes acessam o gateway (ex.: gn100.empresa.local).
# "localhost" serve para testes locais.
SITE_ADDRESS=localhost

# Padrões das chaves novas (scripts/create-key.sh). Cada um pode ser sobrescrito por chave:
#   scripts/create-key.sh <alias> <modelos> <rpm> <paralelas> <validade>
# Modelos pré-selecionados nas chaves novas, separados por vírgula. Precisam estar publicados no
# gateway (painel → Modelos). Vazio = nenhum pré-selecionado; cada chave informa os seus.
KEY_DEFAULT_MODELS=
# Requisições por minuto
KEY_DEFAULT_RPM=30
# Requisições simultâneas
KEY_DEFAULT_PARALLEL=2
# Validade: 30d, 12h, 6mo... ou "never" (sem expiração)
KEY_DEFAULT_DURATION=90d

# Painel de governança (https://<SITE_ADDRESS>:8443). Veja docs/painel.md.
# Redes que podem abrir o painel, separadas por espaço (ex.: 10.10.5.0/24 10.10.6.15/32).
# Vazio = ninguém pela rede; resta o túnel SSH para 127.0.0.1:8080.
PAINEL_CIDR=
# Senhas dos roles do painel no Postgres. Gere cada uma com: openssl rand -hex 24
PAINEL_DB_APP_PASSWORD=
PAINEL_DB_CONTEUDO_PASSWORD=
# Fuso para exibição e para os totais diários de consumo
PAINEL_FUSO=America/Sao_Paulo
# Dias sem login até a desativação automática de um usuário do painel
PAINEL_INATIVIDADE_DIAS=90
# Carência padrão (dias) entre a rotação de uma chave e a revogação da antiga
PAINEL_ROTACAO_CARENCIA_DIAS=7

# Ollama (ajuste após medir na GN100)
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=10m
# Contexto padrão por requisição. Cada modelo reserva memória para contexto × NUM_PARALLEL:
# valores altos fazem o Ollama descarregar outros modelos para abrir espaço.
OLLAMA_CONTEXT_LENGTH=16384
# KV cache quantizado (q8_0 usa metade da memória de f16); exige flash attention.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
